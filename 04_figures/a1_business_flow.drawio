<mxfile host="Electron">
  <diagram id="a1-business-flow" name="A1业务流程草图">
    <mxGraphModel dx="1006" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;align=center;" value="A1 · 网约车业务流程草图 v1.4（下单 → 派单 → 行程 → 支付 → 评分 · 接单后取消两类结果+完成单计费 · 对齐 ER v1.0）" vertex="1">
          <mxGeometry height="30" width="660" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="P" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="乘客发起叫车请求" vertex="1">
          <mxGeometry height="40" width="180" x="330" y="70" as="geometry" />
        </mxCell>
        <mxCell id="Q" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e6;strokeColor=#9673a6;" value="应用层：进入匹配队列&lt;br&gt;（不落库，决策 D-05）" vertex="1">
          <mxGeometry height="50" width="220" x="310" y="150" as="geometry" />
        </mxCell>
        <mxCell id="M" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="平台匹配司机" vertex="1">
          <mxGeometry height="70" width="150" x="345" y="240" as="geometry" />
        </mxCell>
        <mxCell id="X0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="订单作废（不入库）&lt;br&gt;匹配失败或乘客取消" vertex="1">
          <mxGeometry height="50" width="200" x="630" y="245" as="geometry" />
        </mxCell>
        <mxCell id="A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="INSERT Trip：status = &#39;accepted&#39;&lt;br&gt;psg_id、driver_id 写入&lt;br&gt;start_time 默认写入（= 派单时刻）&lt;br&gt;司机绑定唯一 vehicle_id&lt;br&gt;（不换司机由应用层保证）&lt;br&gt;同时 INSERT trip_detail（档次、区位）" vertex="1">
          <mxGeometry height="112" width="270" x="285" y="352" as="geometry" />
        </mxCell>
        <mxCell id="X1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Trip.status = &#39;canceled&#39;（宽限期内取消）&lt;br&gt;免费：无 fare、无 Payment" vertex="1">
          <mxGeometry height="55" width="220" x="640" y="530" as="geometry" />
        </mxCell>
        <mxCell id="X1b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="Trip.status = &#39;canceled&#39;（超宽限期取消）&lt;br&gt;fare = 取消费（课程简化 $1.5）&lt;br&gt;生成 Payment：amount = 取消费" vertex="1">
          <mxGeometry height="70" width="250" x="850" y="370" as="geometry" />
        </mxCell>
        <mxCell id="S" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="乘客上车，行程进行中&lt;br&gt;status = &#39;en_route&#39;（取消与完成的分界）" vertex="1">
          <mxGeometry height="50" width="240" x="300" y="520" as="geometry" />
        </mxCell>
        <mxCell id="C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="行程结束 status = &#39;completed&#39;&lt;br&gt;（含乘客中途提前结束）&lt;br&gt;fare 按实际里程/时长结算" vertex="1">
          <mxGeometry height="65" width="240" x="300" y="620" as="geometry" />
        </mxCell>
        <mxCell id="RT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0f0;strokeColor=#2a9d8f;" value="评分：trip_detail.rating（D-11 已采用）&lt;br&gt;1–5 星，可空，仅 completed&lt;br&gt;与支付结果无关" vertex="1">
          <mxGeometry height="64" width="250" x="680" y="621" as="geometry" />
        </mxCell>
        <mxCell id="PY" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="生成支付 Payment&lt;br&gt;amount（CHECK ≥ 0）、method&lt;br&gt;trip_id UNIQUE → 每行程至多一笔&lt;br&gt;（正常车费与取消费共用通道）" vertex="1">
          <mxGeometry height="70" width="240" x="300" y="730" as="geometry" />
        </mxCell>
        <mxCell id="F" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="闭环：Trip : Payment = 1:1" vertex="1">
          <mxGeometry height="40" width="180" x="330" y="850" as="geometry" />
        </mxCell>
        <mxCell id="U" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="completed 但无 Payment 行&lt;br&gt;（官方 Q2 反连接可查出 → 对账催收）" vertex="1">
          <mxGeometry height="50" width="220" x="630" y="845" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;fontColor=#666666;" value="图例：蓝 = Trip 落库节点｜绿 = Payment/正常闭环｜黄 = 判断｜红 = 取消（作废 / 宽限期免费取消 / 超宽限期收取消费）｜橙 = 挂起/待对账｜紫 = 应用层（不落库）｜青 = trip_detail（D-11 扩展表，官方五表零增列）" vertex="1">
          <mxGeometry height="30" width="800" x="60" y="925" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;fontColor=#9673A6;" value="决策 D-05（Trip 入库时点）：官方 DDL 不变（driver_id NOT NULL），Trip 于派单成功时才 INSERT；下单/匹配在应用层。匹配阶段取消不落库 = 已知取舍。" vertex="1">
          <mxGeometry height="52" width="800" x="60" y="958" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;fontColor=#b85450;" value="决策 D-06（接单后取消的两类结果+完成单计费，v1.1 改名，口径参照 help.uber.com 官方条目）：① 接单后宽限期内取消 → canceled，免费（宽限期因城市而异，本文取 3 分钟为课程简化值）；② 超宽限期取消（含司机到达后乘客未现）→ canceled，fare=取消费（补偿司机接驾空驶 *&quot;pay drivers for the time and effort they spend getting to your location&quot;*，金额因城市/产品而异，本文取固定 $1.5 = REGULAR 档基础价为课程简化值，全程美元（D-06 v1.2）），生成 Payment；接驾异常迟缓可豁免；③ 上车（en_route）后提前结束 → completed，按实际里程/时长计费。&quot;canceled 无 Payment&quot; 旧口径作废。" vertex="1">
          <mxGeometry height="230" width="800" x="60" y="1032" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="P" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="Q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="Q" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="M">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="M" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="X0" value="无人接单 / 乘客取消">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="M" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="A" value="司机接单">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="A" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="X1a" value="宽限期内取消（≈3 分钟）">
          <mxGeometry relative="1" x="0.3778" y="10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="650" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="A" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="X1b" value="接驾途中 / 到达后取消（含未现）">
          <mxGeometry relative="1" x="0.2903" y="25" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="A" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="S" value="乘客上车">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="S" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="C" value="到达终点 / 中途提前结束">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="C" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;strokeColor=#2a9d8f;" target="RT" value="补录评分（可空）">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="C" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="PY">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="PY" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="F" value="支付成功">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="PY" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="U" value="支付失败 / 挂起">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
