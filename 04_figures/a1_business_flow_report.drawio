        <mxCell id="insert" value="&lt;b&gt;Create Trip&lt;/b&gt;&lt;br&gt;status = accepted&lt;br&gt;psg_id · driver_id&lt;br&gt;start_time = dispatch time" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4978b5;strokeWidth=1.5;fontColor=#203348;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
