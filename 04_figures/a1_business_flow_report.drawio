        <mxCell id="cancelfee" value="&lt;b&gt;Charged cancellation&lt;/b&gt;&lt;br&gt;status = canceled&lt;br&gt;fare = $1.50&lt;br&gt;Outside grace / no-show;&lt;br&gt;no pickup-delay waiver&lt;br&gt;Proceed to Payment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbe8e6;strokeColor=#bc6258;strokeWidth=1.5;fontColor=#203348;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="755" y="750" width="280" height="145" />
        </mxCell>
        <mxCell id="free" value="&lt;b&gt;Free / waived cancellation&lt;/b&gt;&lt;br&gt;status = canceled · fare = NULL&lt;br&gt;No Payment&lt;br&gt;&lt;b&gt;End: canceled without charge&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbe8e6;strokeColor=#bc6258;strokeWidth=1.5;fontColor=#203348;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
