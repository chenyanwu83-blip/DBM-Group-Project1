          <mxGeometry as="geometry" x="30" y="320" width="1040" height="28" />
        </mxCell>
        <mxCell id="boundary2" value="DATABASE WORKFLOW · starts at successful dispatch" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#34495e;" vertex="1" parent="1">
