<mxfile host="app.diagrams.net" version="24.7.8">
  <diagram id="a1-business-flow-report" name="A1业务流程·报告版">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req" value="乘客发起叫车请求" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="190" height="48" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="应用层匹配队列&lt;br&gt;（不落库 · D-05）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="190" height="68" as="geometry" />
        </mxCell>
        <mxCell id="void" value="订单作废（不入库）&lt;br&gt;无人接单 / 匹配期取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="196" height="68" as="geometry" />
        </mxCell>
        <mxCell id="insert" value="INSERT Trip&lt;br&gt;status = 'accepted'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="204" width="190" height="68" as="geometry" />
        </mxCell>
        <mxCell id="cancel1" value="宽限期内取消（≈3 分钟）&lt;br&gt;canceled · fare = NULL&lt;br&gt;无 Payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="198" width="196" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cancel2" value="接驾途中 / 到达后取消&lt;br&gt;canceled · fare = $1.5 取消费&lt;br&gt;恰 1 条 Payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="304" width="196" height="76" as="geometry" />
        </mxCell>
        <mxCell id="tripdetail" value="&lt;b&gt;trip_detail&lt;/b&gt;（D-11 · 1:1）&lt;br&gt;接单时写入：&lt;br&gt;service_tier_id · zone_id&lt;br&gt;每 Trip 恰 1 行（含取消）&lt;br&gt;rating：可空，仅 completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="14" y="296" width="190" height="96" as="geometry" />
        </mxCell>
        <mxCell id="enroute" value="乘客上车&lt;br&gt;status = 'en_route'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="308" width="190" height="68" as="geometry" />
        </mxCell>
        <mxCell id="completed" value="行程结束&lt;br&gt;status = 'completed'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="412" width="190" height="68" as="geometry" />
        </mxCell>
        <mxCell id="unpaid" value="未支付 / 挂起&lt;br&gt;completed 但无 Payment&lt;br&gt;1,442 条（占 completed 2.9%）&lt;br&gt;Q2 反连接可查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="408" width="196" height="76" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="生成 Payment&lt;br&gt;trip_id UNIQUE&lt;br&gt;→ 每 Trip 至多 1 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="524" width="190" height="72" as="geometry" />
        </mxCell>
        <mxCell id="footnote" value="颜色：灰 = 应用层（不落库）· 蓝 = Trip 行 · 红 = canceled · 紫 = trip_detail · 绿 = Payment · 橙 = 待对账。&lt;br&gt;D-05：Trip 于司机接单时才入库；D-06：接单后取消两类结果，$1.5 取消费也生成 Payment；D-11：档次、区位、评分由 trip_detail 承载，官方五表零增列。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="24" y="620" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="req" target="queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="派单成功（司机接单）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="queue" target="insert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="queue" target="void">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;exitX=1;exitY=0.47;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="insert" target="cancel1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="insert" target="cancel2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="262" />
              <mxPoint x="450" y="342" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="insert" target="enroute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="到达终点 / 中途提前结束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="enroute" target="completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="支付成功（至多 1 条）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="completed" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="completed" target="unpaid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9a" value="同时写入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="insert" target="tripdetail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9b" value="补录评分（可空）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="completed" target="tripdetail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
