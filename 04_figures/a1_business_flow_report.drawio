        </mxCell>
        <mxCell id="detail" value="&lt;b&gt;Create trip_detail&lt;/b&gt;&lt;br&gt;trip_id PK / FK → Trip&lt;br&gt;service_tier_id → service_tier&lt;br&gt;zone_id → pickup_zone&lt;br&gt;One detail per trip, incl. canceled" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eee7f5;strokeColor=#8c69a7;strokeWidth=1.5;fontColor=#203348;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
